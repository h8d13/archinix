#!/bin/sh -e
# Commit the running system as a new generation, from inside the box.
# Needs a NIXSTORE disk attached (/nixstoredev mounted by the nixgen
# initramfs hook); a blank one gets a store initialized on first commit.
# Snapshots the merged root via a non-recursive bind (submounts like
# /proc, /run, /nixstore fall away), imports it content-addressed,
# appends a GRUB entry on the store disk.
# usage: nixgen-commit <name> [store-root]
#        store-root default /nixstoredev; nixgen-setup passes a freshly
#        formatted target to seed an install
# the store is 0700 root:root and the work below mounts, imports or
# writes it: bail here rather than at whichever privileged call
# happens to fail first, which reads as a missing file
[ "$(id -u)" = 0 ] || { echo "${0##*/}: needs root" >&2; exit 1; }
NAME=$1
TARGET=${2:-/nixstoredev}
[ -n "$NAME" ] || { echo "usage: $0 <name> [store-root]" >&2; exit 1; }
# default target must be the mounted store disk, not the bare
# mountpoint dir baked into every generation; explicit targets
# (nixgen-setup's freshly mounted partition) only need to exist
if [ "$TARGET" = /nixstoredev ]; then
	mountpoint -q /nixstoredev || {
		echo "no writable store: boot with a NIXSTORE disk attached" >&2
		exit 1
	}
elif [ ! -d "$TARGET" ]; then
	echo "no writable store at $TARGET" >&2
	exit 1
fi

SNAP=/run/nixgen-snap
mkdir -p "$SNAP"
mount --bind / "$SNAP"
# -R: the journal mount below is a submount, and a plain umount of a
# tree with one is EBUSY
trap 'umount -R "$SNAP"' EXIT
# rprivate first, or the mount below propagates back to / and hides the
# live journal from the running system
mount --make-rprivate "$SNAP"

# journald preallocates an 8 MiB window and mutates it in place, so a
# content-addressed store sees a wholly new object every time: 8 MiB
# charged per commit whether or not anything was logged, then frozen
# into the generation and rolled back with it. Hidden from the dump
# with an empty tmpfs rather than deleted, because the live journal has
# to keep running (savemeta already prunes this path from the ACL
# manifest, for the same churn reason). Logs that should survive a
# reboot belong on the data partition: /var/log is in the default
# /etc/nixgen/state
if [ -d "$SNAP/var/log/journal" ]; then
	mount -t tmpfs -o size=1M,mode=0755 none "$SNAP/var/log/journal"
fi

# sockets/fifos (NAR can't represent them) are skipped by the dump
# itself: the live root is never mutated to appease the serializer.
# Cached downloads are not system state; this still deletes from the
# live root (nixgen-update scrubs the same)
[ ! -d "$SNAP/var/cache/pacman/pkg" ] || \
	find "$SNAP/var/cache/pacman/pkg" -mindepth 1 -delete

# import dedups against the link farm while it streams: only content
# not already in the store hits the disk, so du (full un-deduped size)
# is a far upper bound. Warn instead of refusing; a genuinely full
# disk aborts the import cleanly mid-stream
NEED=$(du -sxm "$SNAP" | cut -f1)
FREE=$(df -Pm "$TARGET" | awk 'NR==2 { print $4 }')
[ "$FREE" -ge "$NEED" ] || echo "note: snapshot is ${NEED}M un-deduped," \
	"${FREE}M free on $TARGET: only new content lands, but consider" \
	"nixgen-remove of old generations" >&2

/usr/local/bin/nixgen-savemeta "$SNAP"
# import-dir stdout is exactly the store path; mtime-based selection
# (ls -t) cannot work, every store path's mtime is canonicalised to 1
NEW=$(/usr/local/bin/import-dir \
	"$TARGET" "$NAME" "$SNAP")
GEN=$(basename "$NEW")

/usr/local/lib/nixgen-entry "$TARGET" "$GEN" committed
echo "committed: $GEN"
