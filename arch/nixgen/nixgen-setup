#!/bin/sh -e
# Install the running system onto a disk, from inside the box: GPT
# (ESP + NIXSTORE ext4), standalone UEFI GRUB that only sources
# entries.cfg from the store partition, fresh store seeded with a
# commit of the running root: shape the system first, install what you
# actually run. Firmware boots the
# removable path (EFI/BOOT/BOOTX64.EFI), no NVRAM entry needed.
# UEFI only, Secure Boot off. Everything on the target is lost; the
# device path must be typed back. GRUB finds the store by label: if
# the installer medium is itself a NIXSTORE disk (flashed stick),
# unplug it before first boot.
# usage: nixgen-setup <device> [name] [--fs <type>] [--data <size>]
#                     [-u <user>]
#        name default nixarch-install, fs default ext4 (nixgen-fs holds
#        the filesystem table; GRUB has to be able to read the store, so
#        the choice is between the journalling/CoW ones, not FAT).
#        --data carves a NIXDATA partition of <size> (same fs), seeds
#        it from the running root and stamps nixdata=NIXDATA into the
#        installed entry: the single-disk persistent-state flow
#        -u creates a login user before the commit, the only point where
#        the account and its home end up in the same generation
#        --encrypt puts LUKS2 under that data partition and stamps the
#        unlock onto the entry; nixgen-crypt holds the table, and why
#        it is the only encryptable thing here
# the store is 0700 root:root and the work below mounts, imports or
# writes it: bail here rather than at whichever privileged call
# happens to fail first, which reads as a missing file
[ "$(id -u)" = 0 ] || { echo "${0##*/}: needs root" >&2; exit 1; }
. /usr/local/lib/nixgen-fs
. /usr/local/lib/nixgen-crypt

DEV= NAME= FS=ext4 DATA= NEWUSER= ENC=
while [ $# -gt 0 ]; do
	case $1 in
	--fs) FS=$2; shift 2 ;;
	--fs=*) FS=${1#--fs=}; shift ;;
	--data) DATA=$2; shift 2 ;;
	--data=*) DATA=${1#--data=}; shift ;;
	--encrypt) ENC=1; shift ;;
	-u|--user) NEWUSER=$2; shift 2 ;;
	-u=*) NEWUSER=${1#-u=}; shift ;;
	--user=*) NEWUSER=${1#--user=}; shift ;;
	-*) echo "unknown option: $1" >&2; exit 1 ;;
	*)
		if [ -z "$DEV" ]; then DEV=$1; else NAME=$1; fi
		shift
		;;
	esac
done
NAME=${NAME:-nixarch-install}
# filesystem first: a typo there is worth naming on its own, before the
# device check turns it into a usage dump
is_supported_fs "$FS" || exit 1
[ -b "$DEV" ] || {
	# the list comes from the table, so a filesystem added there shows
	# up here without touching this script
	echo "usage: $0 <device> [name] [--fs <type>]" \
		"[--data <size>] [--encrypt] [-u <user>]" >&2
	echo "  <type>: $(echo "$NIXGEN_FS_ALL" | tr ' ' '|') (default ext4)" >&2
	for f in $NIXGEN_FS_ALL; do
		printf '  %-6s mkfs from %s\n' "$f" "$(fs_pkg "$f")" >&2
	done
	exit 1
}
# persistent rows, not just a manifest: volatile rows are backed by the
# store disk or a tmpfs and would leave the data partition empty
[ -z "$DATA" ] || [ -n "$(/usr/local/lib/nixgen-statepaths persistent)" ] || {
	echo "--data without persistent rows in /etc/nixgen/state:" \
		"nothing would ever mount" >&2
	exit 1
}
# the data partition is the only encryptable one, so there is nothing
# for --encrypt to act on without --data
if [ -n "$ENC" ]; then
	[ -n "$DATA" ] || {
		echo "--encrypt without --data: no data partition" >&2
		exit 1
	}
	# fixed mapper name (the boot entry names the container by it), so
	# a taken one is a collision. Checked before cleanup() can close a
	# mapper it did not open
	[ ! -b "/dev/mapper/$NIXGEN_CRYPT_NAME" ] || {
		echo "refusing: /dev/mapper/$NIXGEN_CRYPT_NAME is open" >&2
		exit 1
	}
fi
case $DEV in
*[0-9]) PART="${DEV}p" ;;
*) PART="$DEV" ;;
esac

# covers the running store disk and the boot medium: both are mounted
if grep -q "^$DEV" /proc/mounts; then
	echo "refusing: $DEV has mounted partitions" >&2
	exit 1
fi

lsblk -dn -o NAME,SIZE,MODEL,TRAN "$DEV"
printf 'everything on %s will be lost. type the device path to continue: ' "$DEV"
read -r reply
[ "$reply" = "$DEV" ] || { echo "aborted"; exit 1; }

# Minted here rather than on the installed box, and before anything is
# written to the disk (a taken name aborts with the target intact):
# /etc rides in the generation while /home can ride the data partition,
# so a useradd after the install lands in the RAM upper, is gone at the
# next reboot, and strands the home directory for the next uid to
# inherit. The password is a write like any other: set it and
# nixgen-commit, same rule as root's (nixgen-getty).
if [ -n "$NEWUSER" ]; then
	useradd -m "$NEWUSER"
fi

# install is rare: its deps stay out of the generations and land in
# the ephemeral upper on demand (gone at reboot unless committed).
# Plain -S against the generation's baked db: versions match the
# running snapshot, no partial upgrade (-Sy <pkg> is never right). A
# stale generation's versions may be gone from live mirrors; the
# consistent way forward is a full update, not a db refresh here.
# CRYPTPKG unquoted: empty without --encrypt, one word with it
CRYPTPKG=
[ -z "$ENC" ] || CRYPTPKG=$(crypt_pkg)
pacman -S --needed --noconfirm grub dosfstools "$(fs_pkg "$FS")" $CRYPTPKG || {
	echo "setup: dep install failed (stale generation?);" \
		"nixgen-update + reboot, then retry" >&2
	exit 1
}

# data before store: the data size is known, the store takes the rest,
# so no size arithmetic. GRUB finds the store by label, never by number
STOREPART=${PART}2 DATAPART=
if [ -n "$DATA" ]; then
	STOREPART=${PART}3 DATAPART=${PART}2
	sfdisk -q "$DEV" <<EOF
label: gpt
start=1MiB, size=64MiB, type=uefi
size=$DATA, type=linux
type=linux
EOF
else
	sfdisk -q "$DEV" <<EOF
label: gpt
start=1MiB, size=64MiB, type=uefi
start=65MiB, type=linux
EOF
fi
udevadm settle --timeout=10
mkfs.fat -F 32 -n NIXBOOT "${PART}1"
fs_mkfs "$FS" "$STOREPART" NIXSTORE

# trap armed before the first cryptsetup open, not just before the
# first mount: a mapper left behind by a failed mkfs is a device the
# next run refuses on
T=$(mktemp -d /run/nixgen-setup.XXXXXX)
cleanup() {
	for m in "$T/esp" "$T/store" "$T/data"; do
		if mountpoint -q "$m"; then
			umount "$m"
		fi
	done
	# after the unmounts: a mapper carrying a mounted filesystem
	# cannot close
	if [ -b "/dev/mapper/$NIXGEN_CRYPT_NAME" ]; then
		crypt_close
	fi
	rm -rf "$T"
}
trap cleanup EXIT
mkdir "$T/esp" "$T/store" "$T/data"

# LUKS goes under the filesystem, so mkfs and the seeding below work on
# the mapper. KPARAMS carries its trailing space, so an unencrypted
# install stamps the entry with exactly what it did before
DATADEV=$DATAPART KPARAMS=
if [ -n "$ENC" ]; then
	crypt_format "$DATAPART"
	crypt_open "$DATAPART"
	DATADEV=/dev/mapper/$NIXGEN_CRYPT_NAME
	KPARAMS="$(crypt_params "$DATAPART") "
fi
[ -z "$DATA" ] || fs_mkfs "$FS" "$DATADEV" NIXDATA

# GRUB's whole job is finding the store partition and deferring to its
# entries.cfg, which commit/update/adopt append to
cat > "$T/embed.cfg" <<EOF
set default=0
set timeout=5
insmod part_gpt
search --no-floppy --set=nixdev --label NIXSTORE
if [ -n "\$nixdev" ]; then
	source (\$nixdev)/entries.cfg
else
	echo "NIXSTORE partition not found"
fi
EOF
grub-mkstandalone -O x86_64-efi --locales= --themes= \
	-o "$T/BOOTX64.EFI" "boot/grub/grub.cfg=$T/embed.cfg"

mount "${PART}1" "$T/esp"
install -D "$T/BOOTX64.EFI" "$T/esp/EFI/BOOT/BOOTX64.EFI"
umount "$T/esp"

mount "$STOREPART" "$T/store"
/usr/local/bin/nixgen-commit "$NAME" "$T/store"
if [ -n "$DATA" ]; then
	# seed from the running root (what the user shaped is what the
	# installed /home starts as), then stamp the flags into the entry
	# commit just wrote: a fresh store has exactly that one entry, so
	# the sed cannot touch anything else. rd.luks.name= rides the entry
	# for the same reason nixdata= does, which disks a boot unlocks is
	# a property of the entry and not of the generation, so later
	# commits and updates inherit it from the running cmdline
	# (nixgen-entry)
	mount "$DATADEV" "$T/data"
	/usr/local/lib/nixgen-seedstate "$T/data" \
		$(/usr/local/lib/nixgen-statepaths persistent)
	umount "$T/data"
	sed -i "s|^\tlinux .*|& ${KPARAMS}nixdata=NIXDATA|" \
		"$T/store/entries.cfg"
fi
umount "$T/store"

[ -z "$NEWUSER" ] || echo "user: $NEWUSER (committed with the generation)"
[ -z "$ENC" ] || echo "data partition encrypted (keep the passphrase," \
	"there is no second keyslot)"
echo "installed: $NAME on $DEV (unplug the installer medium, reboot)"
