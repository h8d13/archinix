#!/bin/sh -e
# Delete committed generations from the store disk, from inside the
# box: disk + db together via the GC codepath (rm-path refuses paths
# other valid paths still reference; never rm -rf inside a store), then
# prune their GRUB entries from entries.cfg. The running generation is
# refused; generations living only in the ISO squashfs are untouchable
# here anyway (read-only store).
# usage: nixgen-remove <name|id>...
# the store is 0700 root:root and the work below mounts, imports or
# writes it: bail here rather than at whichever privileged call
# happens to fail first, which reads as a missing file
[ "$(id -u)" = 0 ] || { echo "${0##*/}: needs root" >&2; exit 1; }
[ $# -ge 1 ] || { echo "usage: $0 <name|id>..." >&2; exit 1; }
# mountpoint, not -d: generations carry the bare mountpoint dir, a
# diskless boot would GC a RAM copy and touch nothing real
mountpoint -q /nixstoredev || {
	echo "no writable store: boot with a NIXSTORE disk attached" >&2
	exit 1
}
# after a nixgen-switch the cmdline names the boot-time generation; the
# marker (written by switch, absent on a real boot) is the live one
if [ -s /run/nixgen-active ]; then
	RUNNING=$(cat /run/nixgen-active)
else
	RUNNING=$(sed -n 's/.*nixgen=\([^ ]*\).*/\1/p' /proc/cmdline)
fi

rc=0
for GEN in "$@"; do
	# bare names (the <name> given at import) and hash prefixes
	# (nixgen-listid ids) resolve to <hash>-<name>; store-resolve asks
	# the db, which is the only thing that knows what is registered.
	# Globbing the store dir here used to match the .links farm and
	# half-written tmp-* imports as readily as real generations.
	if ! GEN=$(store-resolve /nixstoredev "$GEN"); then
		rc=1
		continue
	fi
	if [ "$GEN" = "$RUNNING" ]; then
		echo "refusing to remove the running generation: $GEN" >&2
		rc=1
		continue
	fi
	/usr/local/bin/rm-path \
		/nixstoredev "$GEN" || { rc=1; continue; }
	# prune the generation's menu block (menuentry line through '}')
	if [ -f /nixstoredev/entries.cfg ]; then
		awk -v g="$GEN" '
			$0 ~ "^menuentry .*" g { skip = 1 }
			!skip { print }
			skip && /^}/ { skip = 0 }
		' /nixstoredev/entries.cfg > /nixstoredev/entries.cfg.new
		mv /nixstoredev/entries.cfg.new /nixstoredev/entries.cfg
	fi
	echo "removed: $GEN (GRUB entry pruned)"
done
exit $rc
