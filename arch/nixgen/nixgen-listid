#!/bin/sh -e
# List generations with a short id, from inside the box. Source:
# disk = the writable NIXSTORE store, iso = the boot medium squashfs;
# on a disk boot /nixstore aliases the disk store, listed once.
# Short id = first 8 hash chars, for eyeballing; nixgen-remove/-switch
# take the plain name (when unique) or the full basename.
# Added-at is dd/mm/yyyy hh:mm local time, from the store db by way of
# store-paths. The ISO store has no db to ask, so its rows show "-".
# usage: nixgen-listid
# the store is 0700 root:root: bail here rather than deep in a read
# that surfaces as "generation not found" when the real problem is
# that the store was never readable
[ "$(id -u)" = 0 ] || { echo "${0##*/}: needs root" >&2; exit 1; }

# after a nixgen-switch the cmdline names the boot-time generation; the
# marker (written by switch, absent on a real boot) is the live one
if [ -s /run/nixgen-active ]; then
	RUNNING=$(cat /run/nixgen-active)
else
	RUNNING=$(sed -n 's/.*nixgen=\([^ ]*\).*/\1/p' /proc/cmdline)
fi

# rows in on stdin as <basename><TAB><epoch>, source tag in $1.
# Sorted on the generation name, which is what an operator scans for:
# store-paths sorts by basename, so hash first, and a directory listing
# comes out in readdir order.
emit() {
	src=$1
	while IFS='	' read -r g t; do
		printf '%s\t%s\t%s\n' "${g#*-}" "$g" "$t"
	done | sort | while IFS='	' read -r name g t; do
		case $t in
		'' | 0) when='-' ;;
		*) when=$(date -d "@$t" '+%d/%m/%Y %H:%M') ;;
		esac
		mark=
		if [ "$g" = "$RUNNING" ]; then
			mark=" (running)"
		fi
		printf '%.8s  %-4s  %-16s  %s%s\n' \
			"$g" "$src" "$when" "$name" "$mark"
	done
}

# mkiso squashes the store directory alone, without nix/var beside it,
# so the ISO store has no db: its paths can only be read off the
# directory, which means filtering out libnixstore's own entries (the
# .links dedup farm, half-written tmp-* imports) by hand. The disk
# store is asked properly, through store-paths.
list_iso() {
	for p in "$1"/*; do
		[ -d "$p" ] || continue
		g=${p##*/}
		case $g in .links | tmp-*) continue ;; esac
		printf '%s\t0\n' "$g"
	done
}

# the store dir spelled out only to compare mounts: on a disk boot the
# initramfs bind-mounts the disk store onto /nixstore, and the same
# store listed twice is worse than the one extra path here
ROOT=/nixstoredev
DISK=$ROOT/nix/store
if [ -d "$DISK" ] && [ -d /nixstore ] \
		&& [ "$(stat -c %d /nixstore)" = "$(stat -c %d "$DISK")" ]; then
	/usr/local/bin/store-paths "$ROOT" | emit disk
else
	if [ -d /nixstore ]; then
		list_iso /nixstore | emit iso
	fi
	if [ -d "$DISK" ]; then
		/usr/local/bin/store-paths "$ROOT" | emit disk
	fi
fi
